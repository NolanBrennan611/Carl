# Copy to .env and fill in. NEVER commit .env.
# Use the DEV bot token locally; the prod token lives only on the prod host.
DISCORD_TOKEN=
CARL_GUILD_ID=
CARL_HOUSEHOLD_ROLE_ID=
# Optional: members with this role (or Manage Server) are admins
CARL_ADMIN_ROLE_ID=
CARL_DEFAULT_TIMEZONE=America/Chicago
CARL_DEFAULT_CURRENCY=USD
CARL_DATE_ORDER=MDY
CARL_DATA_DIR=./data
CARL_BACKUP_TIME=03:30
CARL_LOG_LEVEL=INFO
CARL_HEALTHCHECK_URL=
CARL_ENV=dev
